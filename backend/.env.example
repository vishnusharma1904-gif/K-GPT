# =============================================================================
# K-GPT backend — environment template
# Copy to `.env` and fill in. Anything left blank degrades gracefully:
# the related subsystem simply turns off (the app still boots and serves chat).
# =============================================================================

# --- App ---------------------------------------------------------------------
ENV=development                      # production | prod enables fail-closed checks
DEBUG=true
SECRET_KEY=CHANGE_ME_dev_secret      # MUST be a strong random value in production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- College SSO / access gate ----------------------------------------------
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAIN=ksrmce.ac.in
ADMIN_EMAILS=vishnusharma1904@gmail.com

# --- Auth hardening ----------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=false
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
TOKEN_TTL_HOURS=24

# --- SMTP (optional; logs to console in dev when unset) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=K-GPT <no-reply@ksrmce.ac.in>

# --- Observability -----------------------------------------------------------
SENTRY_DSN=

# --- Supabase (kept for backward compatibility during migration) -------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Prompt Pulse Phase 1: self-hosted infrastructure ------------------------
# Leave any of these blank to disable that service (health endpoint will show
# "not_configured" and the app falls back to the legacy in-process path).
DATABASE_URL=                        # e.g. postgresql://user:pass@localhost:5432/kgpt
REDIS_URL=                           # e.g. redis://localhost:6379/0
QDRANT_HOST=                         # e.g. localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_HTTPS=false                   # false for local/Docker (plain HTTP); true ONLY for a TLS cloud Qdrant
RABBITMQ_URL=                        # e.g. amqp://guest:guest@localhost:5672/
NEO4J_URI=                           # e.g. bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- LLM providers (LiteLLM reads these from env automatically) --------------
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=                   # required for embeddings + reranking
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
NVIDIA_NIM_API_KEY=
ZENMUX_API_KEY=                      # ZenMux gateway — unlocks cheap/free models (zenmux/* in models.json)
TAVILY_API_KEY=                      # optional web search

# --- OCR / handwriting -------------------------------------------------------
# Scanned/handwritten pages escalate from Tesseract to a cheap vision model for
# 90%+ handwriting accuracy. Default reuses GEMINI_API_KEY (~$0.001/page). Swap
# the model id for "mistral/mistral-ocr-latest" or a Fireworks Qwen-VL id, or set
# OCR_VISION_ENABLED=false to stay fully offline (Tesseract only).
OCR_VISION_ENABLED=true
OCR_VISION_MODEL=gemini/gemini-2.5-flash-lite

# --- Quota defaults ----------------------------------------------------------
DEFAULT_QUOTA_TOKENS=1500000         # legacy, replaced by daily/weekly
DEFAULT_DAILY_TOKENS=350000
DEFAULT_WEEKLY_TOKENS=1750000
DEFAULT_DAILY_MSGS=200
PREMIUM_MODELS_FOR_STUDENTS=false

# --- Razorpay billing --------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SEMESTER_FEE_INR=500
GST_PERCENT=18
GST_INCLUDED=true
CURRENT_SEMESTER=2026-ODD
